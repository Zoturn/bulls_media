# Copy to .env before running anything:  cp .env.example .env
#
# .env is git-ignored. Never put a real key in this file, in source, or in a test — a hook
# (.claude/hooks/secrets-guard.sh) refuses those writes, because a key committed to a public
# repository is disclosed the moment it is pushed and can only be remedied by revoking it.

# --- Database ---------------------------------------------------------------------------------
# SQLite keeps first-run setup to `npm run db:migrate` with no service to install. To move to
# PostgreSQL, change this URL and the `provider` in prisma/schema.prisma — nothing else.
DATABASE_URL="file:./dev.db"

# --- Model provider ---------------------------------------------------------------------------
# Required only to run the agent against a real model. The Jest suite never reads it: jest.setup.ts
# deletes it, and every unit test drives the orchestrator with a mock model instead. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# The model the orchestrator plans and drafts with.
AGENT_MODEL=claude-sonnet-5

# --- Agent limits -----------------------------------------------------------------------------
# Hard ceiling on tool-calling iterations in one run. A bounded loop is the difference between a
# run that fails and a run that bills indefinitely.
AGENT_MAX_STEPS=12

# Wall-clock ceiling for a single run, in milliseconds.
AGENT_TIMEOUT_MS=120000

# --- Logging ----------------------------------------------------------------------------------
# `debug` includes every tool call's arguments and result. `info` is the default for normal use.
LOG_LEVEL=info
